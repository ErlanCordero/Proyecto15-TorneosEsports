@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="admin-dashboard">

    <!-- Encabezado -->
    <header class="dashboard-header">
        <div>
            <span class="dashboard-tag">TORNEOS ESPORTS</span>
            <h1>Panel de Administración</h1>
            <p>Gestiona y supervisa la seguridad de tu plataforma.</p>
        </div>

        <div class="admin-badge">
            <span class="status-dot"></span>
            Administrador
        </div>
    </header>

    <!-- Bienvenida -->
    <section class="welcome-card">
        <div class="welcome-content">
            <span class="welcome-label">CENTRO DE CONTROL</span>

            <h2>¡Bienvenido al panel administrativo!</h2>

            <p>
                Desde aquí puedes supervisar la plataforma y consultar
                los eventos de seguridad de TorneosEsports.
            </p>

            <a asp-controller="Admin"
               asp-action="Bitacora"
               class="welcome-button">
                Consultar bitácora
                <span>→</span>
            </a>
        </div>

        <div class="welcome-icon">🎮</div>
    </section>

    <!-- Indicadores -->
    <section class="dashboard-section">
        <div class="section-heading">
            <div>
                <span class="section-label">ESTADÍSTICAS</span>
                <h2>Resumen general</h2>
            </div>
        </div>

        <div class="stats-grid">

            <article class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon purple">🏆</div>
                    <span class="stat-status">Pendiente</span>
                </div>

                <h3>Torneos</h3>
                <p class="stat-value">—</p>

                <span class="stat-description">
                    Módulo pendiente de integración
                </span>
            </article>

            <article class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon blue">🎮</div>
                    <span class="stat-status">Pendiente</span>
                </div>

                <h3>Videojuegos</h3>
                <p class="stat-value">—</p>

                <span class="stat-description">
                    Módulo pendiente de integración
                </span>
            </article>

            <article class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon green">👥</div>
                    <span class="stat-status active-status">En funcionamiento</span>
                </div>

                <h3>Usuarios</h3>
                <p class="stat-value">@ViewBag.TotalUsuarios</p>

                <span class="stat-description">
                    Cuentas registradas en el sistema
                </span>
            </article>

        </div>
    </section>

    <!-- Administración -->
    <section class="dashboard-section">
        <div class="section-heading">
            <div>
                <span class="section-label">GESTIÓN DEL SISTEMA</span>
                <h2>Administración</h2>
            </div>
        </div>

        <div class="modules-grid">

            <article class="module-card pending-card">
                <div class="module-icon purple">🏆</div>

                <div class="module-content">
                    <h3>Gestionar torneos</h3>
                    <p>
                        Crear, consultar y administrar los torneos.
                    </p>

                    <span class="module-status">
                        Pendiente de integración
                    </span>
                </div>
            </article>

            <article class="module-card pending-card">
                <div class="module-icon blue">🎮</div>

                <div class="module-content">
                    <h3>Gestionar videojuegos</h3>
                    <p>
                        Consultar y administrar los videojuegos disponibles.
                    </p>

                    <span class="module-status">
                        Pendiente de integración
                    </span>
                </div>
            </article>

            <article class="module-card pending-card">
                <div class="module-icon green">👥</div>

                <div class="module-content">
                    <h3>Gestionar usuarios</h3>
                    <p>
                        Próximamente, consultar y administrar las cuentas.
                    </p>

                    <span class="module-status">
                        Pendiente de integración
                    </span>
                </div>
            </article>

        </div>
    </section>

    <!-- Seguridad -->
    <section class="dashboard-section">
        <div class="section-heading">
            <div>
                <span class="section-label">PROTECCIÓN Y AUDITORÍA</span>
                <h2>Seguridad</h2>
            </div>
        </div>

        <div class="security-card">

            <div class="security-icon">📋</div>

            <div class="security-content">
                <h3>Bitácora de acciones</h3>

                <p>
                    Consulta los inicios de sesión exitosos,
                    intentos fallidos y cierres de sesión registrados.
                </p>

                <div class="security-tags">
                    <span>Autenticación</span>
                    <span>Auditoría</span>
                    <span>SQL Server</span>
                </div>
            </div>

            <a asp-controller="Admin"
               asp-action="Bitacora"
               class="security-button">
                Ver registros
                <span>→</span>
            </a>

        </div>
    </section>

    <!-- Pie de página -->
    <footer class="dashboard-footer">
        <span class="footer-brand">TORNEOS ESPORTS</span>
        <span>Panel de Administración · Seguridad y control</span>
    </footer>

</div>

<style>
    .admin-dashboard {
        max-width: 1200px;
        margin: 0 auto;
        padding: 35px 24px;
        color: #f1f5f9;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 32px;
    }

    .dashboard-tag,
    .section-label {
        color: #a78bfa;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2.5px;
    }

    .dashboard-header h1 {
        margin: 9px 0;
        font-size: clamp(27px, 4vw, 36px);
        font-weight: 800;
        letter-spacing: -1px;
    }

    .dashboard-header p {
        color: #94a3b8;
        margin: 0;
        line-height: 1.7;
    }

    .admin-badge {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 11px 16px;
        border-radius: 30px;
        border: 1px solid #334155;
        background: #111827;
        color: #e2e8f0;
        font-size: 13px;
        white-space: nowrap;
    }

    .status-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 10px #22c55e66;
    }

    .welcome-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        padding: 36px;
        margin-bottom: 42px;
        overflow: hidden;
        border: 1px solid #4c1d95;
        border-radius: 20px;
        background: radial-gradient(circle at 85% 20%, #7c3aed55, transparent 30%), linear-gradient(120deg, #1e1b4b, #312e81, #581c87);
    }

    .welcome-content {
        max-width: 700px;
    }

    .welcome-label {
        color: #c4b5fd;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .welcome-card h2 {
        margin: 12px 0;
        font-size: clamp(22px, 3vw, 30px);
        font-weight: 800;
        line-height: 1.3;
    }

    .welcome-card p {
        max-width: 620px;
        margin-bottom: 23px;
        color: #ddd6fe;
        font-size: 14px;
        line-height: 1.8;
    }

    .welcome-icon {
        font-size: 75px;
        filter: drop-shadow(0 0 18px #a78bfa55);
    }

    .welcome-button,
    .security-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 12px 18px;
        border-radius: 10px;
        background: #8b5cf6;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.2s, transform 0.2s;
    }

        .welcome-button:hover,
        .security-button:hover {
            background: #7c3aed;
            color: #fff;
            transform: translateY(-2px);
        }

        .welcome-button span,
        .security-button span {
            font-size: 19px;
        }

    .dashboard-section {
        margin-bottom: 42px;
    }

    .section-heading {
        margin-bottom: 20px;
    }

        .section-heading h2 {
            margin: 7px 0 0;
            font-size: 22px;
            font-weight: 800;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
    }

    .stat-card {
        min-width: 0;
        padding: 24px;
        border: 1px solid #273449;
        border-radius: 16px;
        background: #111827;
        transition: border-color 0.2s, transform 0.2s;
    }

        .stat-card:hover {
            border-color: #475569;
            transform: translateY(-3px);
        }

    .stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 20px;
    }

    .stat-icon,
    .module-icon,
    .security-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 12px;
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        font-size: 22px;
    }

    .purple {
        background: #4c1d9533;
        color: #c4b5fd;
    }

    .blue {
        background: #1d4ed833;
        color: #93c5fd;
    }

    .green {
        background: #15803d33;
        color: #86efac;
    }

    .stat-status {
        color: #cbd5e1;
        font-size: 10px;
        font-weight: 600;
        text-align: right;
    }

    .active-status {
        color: #86efac;
    }

    .stat-card h3 {
        margin-bottom: 7px;
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 600;
    }

    .stat-value {
        margin: 0 0 7px;
        color: #f8fafc;
        font-size: 35px;
        font-weight: 800;
    }

    .stat-description {
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.6;
    }

    .modules-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .module-card {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        min-width: 0;
        padding: 22px;
        border: 1px solid #273449;
        border-radius: 16px;
        background: #111827;
    }

    .module-icon {
        width: 45px;
        height: 45px;
        font-size: 22px;
    }

    .module-content {
        min-width: 0;
    }

    .module-card h3 {
        margin: 2px 0 9px;
        color: #f1f5f9;
        font-size: 15px;
        font-weight: 700;
    }

    .module-card p {
        margin-bottom: 16px;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.7;
    }

    .module-status {
        color: #cbd5e1;
        font-size: 10px;
        font-weight: 600;
    }

    .security-card {
        display: flex;
        align-items: center;
        gap: 22px;
        padding: 26px;
        border: 1px solid #4c1d95;
        border-radius: 18px;
        background: linear-gradient(120deg, #111827, #1e1b4b);
    }

    .security-icon {
        width: 58px;
        height: 58px;
        background: #6d28d933;
        font-size: 28px;
    }

    .security-content {
        flex: 1;
        min-width: 0;
    }

        .security-content h3 {
            margin: 0 0 8px;
            font-size: 17px;
            font-weight: 800;
        }

        .security-content p {
            margin: 0 0 14px;
            color: #94a3b8;
            font-size: 13px;
            line-height: 1.7;
        }

    .security-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

        .security-tags span {
            padding: 5px 9px;
            border: 1px solid #475569;
            border-radius: 20px;
            color: #cbd5e1;
            font-size: 10px;
        }

    .security-button {
        flex-shrink: 0;
    }

    .dashboard-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding-top: 22px;
        border-top: 1px solid #273449;
        color: #64748b;
        font-size: 11px;
    }

    .footer-brand {
        color: #a78bfa;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    @@media (max-width: 900px) {
        .stats-grid,
        .modules-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .security-card {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .security-button {
            margin-left: 80px;
        }
    }

    @@media (max-width: 600px) {
        .admin-dashboard {
            padding: 25px 14px;
        }

        .dashboard-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .welcome-card {
            padding: 25px;
        }

        .welcome-icon {
            font-size: 45px;
        }

        .stats-grid,
        .modules-grid {
            grid-template-columns: 1fr;
        }

        .security-card {
            flex-direction: column;
        }

        .security-button {
            margin-left: 0;
        }

        .dashboard-footer {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>